<Window x:Class="SistemaTransportes.VentaBoletosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        mc:Ignorable="d"
        Title="Sistema de Transportes - Punto de Venta Integrada"
        Height="860" Width="1340"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgGeneralBrush}">
    <Window.Resources>
        <!-- Estilo modular y plantilla interactiva para los asientos del bus -->
        <Style x:Key="BotonAsientoStyle" TargetType="Button">
            <Setter Property="Command" Value="{Binding ClickCommand}" />
            <Setter Property="IsEnabled" Value="{Binding EsClickeable}" />
            <Setter Property="Visibility" Value="{Binding Converter={StaticResource NullToVisConverter}}" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{Binding EstadoVisual, Converter={StaticResource EstadoAsientoConverter}}"
                                CornerRadius="6" Padding="4,2">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Icono del Asiento -->
                                <Image Grid.Column="0"
                                       Source="pack://application:,,,/SistemaTransportes;component/imagenes/asiento_white.png"
                                       Width="20" Height="20" Stretch="Uniform"
                                       Margin="0,0,5,0" VerticalAlignment="Center" />
                                <!-- Número y Estado -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NroAsiento, StringFormat='N° {0}'}"
                                               FontFamily="Segoe UI" FontWeight="Bold" FontSize="11.5"
                                               Foreground="White" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding Estado}" FontFamily="Segoe UI" FontSize="8.5"
                                               Foreground="#F1F5F9" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding EsSeleccionado}" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource ContrastOrangeBrush}" />
                                <Setter TargetName="b" Property="BorderThickness" Value="2.5" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo modular y plantilla interactiva para las insignias (pills/badges) de categoría -->
        <Style x:Key="CategoriaBadgeControlStyle" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border x:Name="BadgeBorder"
                                Background="#EBF5FB" BorderBrush="#AED6F1" BorderThickness="1"
                                CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <fa:IconImage x:Name="BadgeIcon" Icon="Chair" Width="12" Height="12" Foreground="#1B4F72" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="CatText" Text="{Binding Categoria}" FontFamily="Segoe UI" FontWeight="Bold" FontSize="11"
                                           Foreground="#1B4F72" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Clásico: Fondo #EBF5FB, Borde #AED6F1, Texto #1B4F72, Ícono asiento estándar -->
                            <DataTrigger Binding="{Binding Categoria}" Value="Clásico">
                                <Setter TargetName="BadgeBorder" Property="Background" Value="#EBF5FB" />
                                <Setter TargetName="BadgeBorder" Property="BorderBrush" Value="#AED6F1" />
                                <Setter TargetName="BadgeIcon" Property="Icon" Value="Chair" />
                                <Setter TargetName="BadgeIcon" Property="Foreground" Value="#1B4F72" />
                                <Setter TargetName="CatText" Property="Foreground" Value="#1B4F72" />
                            </DataTrigger>
                            <!-- Ejecutivo: Fondo #E8F8F5, Borde #A3E4D7, Texto #0E6251, Ícono ejecutivo -->
                            <DataTrigger Binding="{Binding Categoria}" Value="Ejecutivo">
                                <Setter TargetName="BadgeBorder" Property="Background" Value="#E8F8F5" />
                                <Setter TargetName="BadgeBorder" Property="BorderBrush" Value="#A3E4D7" />
                                <Setter TargetName="BadgeIcon" Property="Icon" Value="Briefcase" />
                                <Setter TargetName="BadgeIcon" Property="Foreground" Value="#0E6251" />
                                <Setter TargetName="CatText" Property="Foreground" Value="#0E6251" />
                            </DataTrigger>
                            <!-- VIP: Fondo #FEF9E7, Borde #F9E79F, Texto #7D6608, Ícono VIP -->
                            <DataTrigger Binding="{Binding Categoria}" Value="VIP">
                                <Setter TargetName="BadgeBorder" Property="Background" Value="#FEF9E7" />
                                <Setter TargetName="BadgeBorder" Property="BorderBrush" Value="#F9E79F" />
                                <Setter TargetName="BadgeIcon" Property="Icon" Value="Star" />
                                <Setter TargetName="BadgeIcon" Property="Foreground" Value="#7D6608" />
                                <Setter TargetName="CatText" Property="Foreground" Value="#7D6608" />
                            </DataTrigger>
                            <!-- Premium: Fondo #F4ECF7, Borde #D2B4DE, Texto #512E5F, Ícono de corona -->
                            <DataTrigger Binding="{Binding Categoria}" Value="Premium">
                                <Setter TargetName="BadgeBorder" Property="Background" Value="#F4ECF7" />
                                <Setter TargetName="BadgeBorder" Property="BorderBrush" Value="#D2B4DE" />
                                <Setter TargetName="BadgeIcon" Property="Icon" Value="Crown" />
                                <Setter TargetName="BadgeIcon" Property="Foreground" Value="#512E5F" />
                                <Setter TargetName="CatText" Property="Foreground" Value="#512E5F" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Body -->
            <RowDefinition Height="*" />
            <!-- Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. HEADER: Resumen de Sesion y Widget de Caja del Turno -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="20,14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Titulo y Sesion -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/SistemaTransportes;component/imagenes/bus.png" Width="26" Height="26" Margin="0,0,8,0"
                               Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="SISTEMA DE TRANSPORTES" 
                                   FontFamily="Segoe UI" FontWeight="Bold" FontSize="18"
                                   Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                        <Border Background="#E2E8F0" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PUNTO DE VENTA INTEGRADA"
                                       FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11"
                                       Foreground="{StaticResource PrimaryAccentBrush}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👤 Operador: " FontFamily="Segoe UI" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding Session.Username}" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="  |  Rol: " FontFamily="Segoe UI" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" />
                        <TextBlock Text="{Binding Session.Rol}" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="  |  Turno ID: #" FontFamily="Segoe UI" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" />
                        <TextBlock Text="{Binding Session.CajaTurnoID}" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Panel Superior Derecho: CAJA DEL TURNO -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Widget Caja del Turno -->
                    <Border Background="{StaticResource CajaBgBrush}"
                            BorderBrush="#A3E4D7" BorderThickness="1.5"
                            CornerRadius="8" Padding="18,8" Margin="0,0,14,0">
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock Text="CAJA DEL TURNO (ACTIVA)"
                                       FontFamily="Segoe UI" FontWeight="Bold" FontSize="11"
                                       Foreground="#117A65" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding SaldoCajaActual, Converter={StaticResource CurrencyConverter}}"
                                       FontFamily="Segoe UI" FontWeight="Bold" FontSize="22"
                                       Foreground="{StaticResource CajaSuccessBrush}"
                                       HorizontalAlignment="Right" />
                        </StackPanel>
                    </Border>

                    <!-- Boton Cerrar Sesion -->
                    <Button Command="{Binding CerrarSesionCommand}" Click="BtnCerrarSesion_Click"
                            Background="#FFF5F5" Foreground="#C53030"
                            BorderBrush="#FEB2B2" BorderThickness="1"
                            FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12.5"
                            Padding="12,8" Cursor="Hand" VerticalAlignment="Center">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Cerrar Sesión" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. BODY: 3 PANELES (IZQUIERDO, CENTRAL, DERECHO) -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <!-- Panel Izquierdo: Mapa de Asientos con Pasillo Central -->
                <ColumnDefinition Width="430" />
                <!-- Panel Central: Datos Pasajero y Viaje -->
                <ColumnDefinition Width="*" />
                <!-- Panel Derecho: Carga Adjunta y Liquidacion -->
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- PANEL IZQUIERDO: Mapa de Asientos Interactivo con Visibilidad Progresiva -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <!-- Estado 1: Placeholder de guía cuando no hay viaje seleccionado -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="24"
                        Visibility="{Binding MostrarMapaAsientos, Converter={StaticResource InverseBoolToVisConverter}}">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="64" Height="64" CornerRadius="32" Background="#F1F5F9"
                                    HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Image Source="pack://application:,,,/SistemaTransportes;component/imagenes/asiento.png"
                                       Width="32" Height="32" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Distribución del Bus" FontFamily="Segoe UI" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="Seleccione un horario de viaje en las tarjetas disponibles para desplegar el mapa interactivo de asientos."
                                       FontFamily="Segoe UI" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" LineHeight="18" Margin="0,0,0,16" />
                            <Border Background="#E0F2F1" CornerRadius="6" Padding="12,8" HorizontalAlignment="Center">
                                <TextBlock Text="Paso 1: Busque y elija una salida ➔" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11.5"
                                           Foreground="{StaticResource TealBrush}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Estado 2: Mapa de Asientos Desplegado (Cuando ViajeSeleccionado != null) -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="16"
                        Visibility="{Binding MostrarMapaAsientos, Converter={StaticResource BoolToVisConverter}}">
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Titulo y Boton Refrescar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/SistemaTransportes;component/imagenes/asiento.png" Width="18" Height="18" Margin="0,0,6,0"
                               Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="Distribución del Bus"
                                   FontFamily="Segoe UI" FontWeight="Bold" FontSize="15"
                                   Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                        <Button Command="{Binding RefrescarMapaCommand}"
                                Content="🔄 Refrescar"
                                Background="Transparent" Foreground="{StaticResource PrimaryAccentBrush}"
                                BorderThickness="0" FontFamily="Segoe UI" FontSize="11.5"
                                Cursor="Hand" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Selector de Pisos -->
                    <Border Grid.Row="1" Background="#F1F5F9" CornerRadius="6" Padding="4" Margin="0,0,0,10">
                        <UniformGrid Columns="2">
                            <Button Content="Piso 1"
                                    Command="{Binding CambiarPisoCommand}"
                                    CommandParameter="1">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="FontFamily" Value="Segoe UI" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="FontSize" Value="12.5" />
                                        <Setter Property="Padding" Value="8,6" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Background" Value="#FFFFFF" />
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="Piso 2"
                                    Command="{Binding CambiarPisoCommand}"
                                    CommandParameter="2">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="FontFamily" Value="Segoe UI" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="FontSize" Value="12.5" />
                                        <Setter Property="Padding" Value="8,6" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Background" Value="#FFFFFF" />
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </UniformGrid>
                    </Border>

                    <!-- Leyenda de Estados de Asientos -->
                    <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="8,6" Margin="0,0,0,10">
                        <UniformGrid Columns="3">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="14" Height="14" CornerRadius="3" Background="{StaticResource AsientoLibreBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="Libre" FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="14" Height="14" CornerRadius="3" Background="{StaticResource AsientoOcupadoBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="Ocupado" FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="14" Height="14" CornerRadius="3" Background="{StaticResource AsientoSeleccionadoBrush}"
                                        BorderBrush="{StaticResource ContrastOrangeBrush}" BorderThickness="1.5" Margin="0,0,6,0" />
                                <TextBlock Text="Seleccionado" FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <!-- Distribucion Visual con Pasillo Central -->
                    <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Cabina Conductor -->
                                <RowDefinition Height="Auto" />
                                <!-- Encabezado de Columnas -->
                                <RowDefinition Height="Auto" />
                                <!-- Lista de Filas de Asientos -->
                                <RowDefinition Height="*" />
                                <!-- Parte Posterior -->
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Cabina Conductor -->
                            <Border Grid.Row="0" Background="#E2E8F0" CornerRadius="6" Padding="8,4" Margin="0,0,0,8">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="pack://application:,,,/SistemaTransportes;component/imagenes/bus.png" Width="14" Height="14" Margin="0,0,6,0"
                                               Stretch="Uniform" VerticalAlignment="Center" />
                                        <TextBlock Text="FRENTE / CABINA CONDUCTOR"
                                                   FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ContentControl HorizontalAlignment="Right" DataContext="{Binding ViajeSeleccionado}" Style="{StaticResource CategoriaBadgeControlStyle}" Margin="0,0,2,0" />
                                </Grid>
                            </Border>

                            <!-- Encabezado de Columnas -->
                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Vent." FontFamily="Segoe UI" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Pas." FontFamily="Segoe UI" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="🚶" FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="Pas." FontFamily="Segoe UI" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="Vent." FontFamily="Segoe UI" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            </Grid>

                            <!-- Filas de Asientos con Pasillo Central -->
                            <Grid Grid.Row="2" MinHeight="260">
                                <!-- Indicador de carga cuando CargandoAsientos es True -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{Binding CargandoAsientos, Converter={StaticResource BoolToVisConverter}}">
                                    <ProgressBar IsIndeterminate="True" Width="140" Height="4" Margin="0,0,0,12" Foreground="{StaticResource TealBrush}" />
                                    <TextBlock Text="Cargando asientos..."
                                               FontFamily="Segoe UI" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>

                                <!-- ScrollViewer con ItemsControl visible cuando CargandoAsientos es False -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              Visibility="{Binding CargandoAsientos, Converter={StaticResource InverseBoolToVisConverter}}">
                                    <ItemsControl ItemsSource="{Binding FilasAsientosVisibles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <!-- Asiento Izq Ventana -->
                                                        <ColumnDefinition Width="*" />
                                                        <!-- Asiento Izq Pasillo -->
                                                        <ColumnDefinition Width="*" />
                                                        <!-- Pasillo Central -->
                                                        <ColumnDefinition Width="46" />
                                                        <!-- Asiento Der Pasillo -->
                                                        <ColumnDefinition Width="*" />
                                                        <!-- Asiento Der Ventana -->
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 1. Asiento Izquierda Ventana -->
                                                    <Button Grid.Column="0" DataContext="{Binding AsientoVentanaIzq}"
                                                            Style="{StaticResource BotonAsientoStyle}" />

                                                    <!-- 2. Asiento Izquierda Pasillo -->
                                                    <Button Grid.Column="1" DataContext="{Binding AsientoPasilloIzq}"
                                                            Style="{StaticResource BotonAsientoStyle}" />

                                                    <!-- 3. Pasillo Central -->
                                                    <Border Grid.Column="2" Background="#E2E8F0" CornerRadius="4"
                                                            Margin="4,2" Height="42" VerticalAlignment="Center">
                                                        <TextBlock Text="||" FontFamily="Segoe UI" FontWeight="Bold" FontSize="10"
                                                                   Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- 4. Asiento Derecha Pasillo -->
                                                    <Button Grid.Column="3" DataContext="{Binding AsientoPasilloDer}"
                                                            Style="{StaticResource BotonAsientoStyle}" />

                                                    <!-- 5. Asiento Derecha Ventana -->
                                                    <Button Grid.Column="4" DataContext="{Binding AsientoVentanaDer}"
                                                            Style="{StaticResource BotonAsientoStyle}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Overlay Informativo cuando el Modo Solo Encomienda está activo -->
                                <Border Background="#F8FAFC" BorderBrush="#BFDBFE" BorderThickness="1.5" CornerRadius="8" Padding="18,24"
                                        VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12"
                                        Visibility="{Binding EsSoloEncomienda, Converter={StaticResource BoolToVisConverter}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border Width="56" Height="56" CornerRadius="28" Background="#EFF6FF" HorizontalAlignment="Center" Margin="0,0,0,12">
                                            <TextBlock Text="📦" FontSize="26" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Modo Encomienda Directa" FontFamily="Segoe UI" FontWeight="Bold" FontSize="14" Foreground="#1E40AF" HorizontalAlignment="Center" />
                                        <TextBlock Text="La carga viaja en la bodega del bus para la ruta seleccionada."
                                                   FontFamily="Segoe UI" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280" Margin="0,6,0,2" />
                                        <TextBlock Text="No se requiere asignación de asientos de pasajeros."
                                                   FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB"
                                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Parte Posterior -->
                            <Border Grid.Row="3" Background="#E2E8F0" CornerRadius="6" Padding="4" Margin="0,8,0,0">
                                <TextBlock Text="SECTOR POSTERIOR / MOTOR"
                                           FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Botón Continuar al Paso 2 (Datos de Pasajeros) -->
                    <Button Grid.Row="4"
                            Command="{Binding IrAPasajerosCommand}"
                            IsEnabled="{Binding PuedeContinuarAPasajeros}"
                            Style="{StaticResource ContrastButtonStyle}"
                            MinHeight="45"
                            Padding="16,8"
                            Margin="0,10,0,0">
                        <TextBlock Text="{Binding TextoBotonContinuar}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="13.5"
                                   FontWeight="Bold"
                                   Foreground="White" />
                    </Button>
                </Grid>
            </Border>
            </Grid>

            <!-- PANEL CENTRAL: Selección de Viaje y Datos del Pasajero -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- ================================================================= -->
                        <!-- PASO 1: SELECCIÓN DE VIAJE Y HORARIOS (MostrarPanelViajes)        -->
                        <!-- ================================================================= -->
                        <StackPanel Visibility="{Binding MostrarPanelViajes, Converter={StaticResource BoolToVisConverter}}">
                            <!-- COMPONENTE: SELECCIÓN DE VIAJE -->
                        <Border Background="White" CornerRadius="10" Margin="0,0,0,16"
                                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.08" ShadowDepth="3" Direction="270" Color="#000000" />
                            </Border.Effect>
                            <StackPanel>
                                <!-- Cabecera Teal -->
                                <Border Background="{StaticResource TealBrush}" CornerRadius="9,9,0,0" Padding="14,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Icono Ticket Vectorial -->
                                        <Path Data="M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v3a2 2 0 0 0 0 4v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-3a2 2 0 0 0 0-4V5zm3 2v2h2V7H6zm0 4v2h2v-2H6zm0 4v2h2v-2H6zm4-8v2h8V7h-8zm0 4v2h8v-2h-8zm0 4v2h8v-2h-8z"
                                              Fill="White" Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Selección de viaje"
                                                   FontFamily="Segoe UI" FontWeight="Bold" FontSize="14.5"
                                                   Foreground="White" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Formulario de Búsqueda Simétrico en una sola fila -->
                                <Grid Margin="12,12,12,14">
                                    <Grid.ColumnDefinitions>
                                        <!-- Origen -->
                                        <ColumnDefinition Width="*" />
                                        <!-- Botón Intercambio ⇄ -->
                                        <ColumnDefinition Width="Auto" />
                                        <!-- Destino -->
                                        <ColumnDefinition Width="*" />
                                        <!-- Fecha Ida -->
                                        <ColumnDefinition Width="*" />
                                        <!-- Fecha Vuelta -->
                                        <ColumnDefinition Width="*" />
                                        <!-- Botón Buscar -->
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 1. Origen -->
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Origen" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11.5"
                                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3" />
                                        <Border BorderBrush="{StaticResource UnderlineBorderBrush}" BorderThickness="0,0,0,1" Padding="0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="0"
                                                      Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm0-14c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6-2.69-6-6-6zm0 8c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"
                                                      Fill="{StaticResource IconGrayBrush}" Stretch="Uniform" Width="13" Height="13"
                                                      VerticalAlignment="Center" Margin="2,0,4,0" />
                                                <Grid Grid.Column="1">
                                                    <ComboBox IsEditable="True"
                                                              ItemsSource="{Binding OrigenesDisponibles}"
                                                              Text="{Binding OrigenSeleccionado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              BorderThickness="0,0,0,1" BorderBrush="Transparent"
                                                              Background="Transparent"
                                                              FontFamily="Segoe UI" FontSize="12"
                                                              Padding="0,2" />
                                                    <TextBlock Text="Seleccione origen"
                                                               FontFamily="Segoe UI" FontSize="12"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center" Margin="3,0,0,0"
                                                               IsHitTestVisible="False">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding OrigenSeleccionado}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding OrigenSeleccionado}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- 2. Botón Intercambio (⇄) -->
                                    <Button Grid.Column="1"
                                            Command="{Binding IntercambiarCiudadesCommand}"
                                            Foreground="{StaticResource IconGrayBrush}"
                                            Background="Transparent" BorderThickness="0"
                                            Cursor="Hand" Margin="2,14,2,0" VerticalAlignment="Center"
                                            ToolTip="Intercambiar origen y destino">
                                        <Button.Content>
                                            <fa:IconImage Icon="RightLeft" Width="15" Height="15"
                                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button.Content>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" Padding="3,2" CornerRadius="4">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource TealBrush}" />
                                                                    <Setter Property="Background" Value="{StaticResource TealLightBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- 3. Destino -->
                                    <StackPanel Grid.Column="2" Margin="4,0,6,0">
                                        <TextBlock Text="Destino" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11.5"
                                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3" />
                                        <Border BorderBrush="{StaticResource UnderlineBorderBrush}" BorderThickness="0,0,0,1" Padding="0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="0"
                                                      Data="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                                                      Fill="{StaticResource IconGrayBrush}" Stretch="Uniform" Width="13" Height="13"
                                                      VerticalAlignment="Center" Margin="2,0,4,0" />
                                                <Grid Grid.Column="1">
                                                    <ComboBox IsEditable="True"
                                                              ItemsSource="{Binding DestinosDisponibles}"
                                                              Text="{Binding DestinoSeleccionado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              BorderThickness="0,0,0,1" BorderBrush="Transparent"
                                                              Background="Transparent"
                                                              FontFamily="Segoe UI" FontSize="12"
                                                              Padding="0,2" />
                                                    <TextBlock Text="Seleccione destino"
                                                               FontFamily="Segoe UI" FontSize="12"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center" Margin="3,0,0,0"
                                                               IsHitTestVisible="False">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DestinoSeleccionado}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding DestinoSeleccionado}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- 4. Fecha de salida -->
                                    <StackPanel Grid.Column="3" Margin="4,0,6,0">
                                        <TextBlock Text="Fecha de salida" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11.5"
                                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3" />
                                        <Border BorderBrush="{StaticResource UnderlineBorderBrush}" BorderThickness="0,0,0,1" Padding="0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="0"
                                                      Data="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11zM7 11h5v5H7z"
                                                      Fill="{StaticResource IconGrayBrush}" Stretch="Uniform" Width="13" Height="13"
                                                      VerticalAlignment="Center" Margin="2,0,4,0" />
                                                <DatePicker Grid.Column="1"
                                                            SelectedDate="{Binding FechaIda, Mode=TwoWay}"
                                                            DisplayDateStart="{Binding FechaMinima, Mode=OneWay}"
                                                            DisplayDateEnd="{Binding FechaMaximaSalida, Mode=OneWay}"
                                                            BorderThickness="0,0,0,1" BorderBrush="Transparent"
                                                            Background="Transparent"
                                                            FontFamily="Segoe UI" FontSize="11.5"
                                                            Padding="0,1" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- 5. Fecha de vuelta (Opcional) -->
                                    <StackPanel Grid.Column="4" Margin="4,0,8,0">
                                        <TextBlock Text="Fecha de vuelta (Opcional)" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11.5"
                                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3" />
                                        <Border BorderBrush="{StaticResource UnderlineBorderBrush}" BorderThickness="0,0,0,1" Padding="0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="0"
                                                      Data="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11zM7 11h5v5H7z"
                                                      Fill="{StaticResource IconGrayBrush}" Stretch="Uniform" Width="13" Height="13"
                                                      VerticalAlignment="Center" Margin="2,0,4,0" />
                                                <DatePicker Grid.Column="1"
                                                            SelectedDate="{Binding FechaVuelta, Mode=TwoWay}"
                                                            DisplayDateStart="{Binding FechaVueltaMinima, Mode=OneWay}"
                                                            DisplayDateEnd="{Binding FechaVueltaMaxima, Mode=OneWay}"
                                                            BorderThickness="0,0,0,1" BorderBrush="Transparent"
                                                            Background="Transparent"
                                                            FontFamily="Segoe UI" FontSize="11.5"
                                                            Padding="0,1" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- 6. Botones Buscar y Limpiar -->
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,14,0,0">
                                        <!-- Botón Buscar -->
                                        <Button Command="{Binding BuscarViajesCommand}"
                                                Content="Buscar"
                                                Height="36"
                                                FontFamily="Segoe UI" FontWeight="Bold" FontSize="13"
                                                Foreground="White" Background="{StaticResource TealBrush}"
                                                Cursor="Hand" Padding="18,0" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource TealHoverBrush}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="btnBorder" Property="Opacity" Value="0.85" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Botón Limpiar -->
                                        <Button Command="{Binding LimpiarBusquedaCommand}"
                                                Content="Limpiar"
                                                Height="36"
                                                FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12.5"
                                                Foreground="#495057" Background="#F1F3F5" BorderBrush="#CED4DA" BorderThickness="1"
                                                Cursor="Hand" Padding="14,0" VerticalAlignment="Center"
                                                ToolTip="Restablecer filtros y limpiar selección">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="btnClear" Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="18" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="btnClear" Property="Background" Value="#E9ECEF" />
                                                                        <Setter TargetName="btnClear" Property="BorderBrush" Value="#ADB5BD" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="btnClear" Property="Opacity" Value="0.85" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ESTADO INFORMATIVO PREVIO A LA BÚSQUEDA -->
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="32,36" Margin="0,0,0,16"
                                Visibility="{Binding MostrarResultadosViajes, Converter={StaticResource InverseBoolToVisConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="60" Height="60" CornerRadius="30" Background="#E0F2F1"
                                        HorizontalAlignment="Center" Margin="0,0,0,14">
                                    <Image Source="pack://application:,,,/SistemaTransportes;component/imagenes/bus.png"
                                           Width="30" Height="30" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Opacity="0.85" />
                                </Border>
                                <TextBlock Text="Consulte Salidas y Horarios"
                                           FontFamily="Segoe UI" FontWeight="Bold" FontSize="15"
                                           Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock Text="Seleccione origen, destino y fecha, luego presione 'Buscar' para ver los horarios disponibles."
                                           FontFamily="Segoe UI" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" LineHeight="18" />
                            </StackPanel>
                        </Border>

                        <!-- 2. SECCIÓN DE RESULTADOS DE VIAJES (CARDS MODERNAS CON HORARIOS Y CATEGORÍAS) -->
                        <StackPanel Visibility="{Binding MostrarResultadosViajes, Converter={StaticResource BoolToVisConverter}}">
                            <!-- Barra de Ordenamiento tipo Píldora -->
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🚌 Salidas Disponibles" FontFamily="Segoe UI" FontWeight="Bold" FontSize="13.5"
                                                   Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Border Background="{StaticResource TealLightBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ViajesDisponibles.Count, StringFormat='{}{0} opciones'}"
                                                       FontFamily="Segoe UI" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TealBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Píldoras de ordenamiento -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Ordenar:" FontFamily="Segoe UI" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />

                                        <!-- Píldora Horario de Salida -->
                                        <Button Command="{Binding OrdenarPorSalidaCommand}"
                                                FontFamily="Segoe UI" FontSize="11.5" FontWeight="SemiBold"
                                                Padding="10,4" Margin="2,0" Cursor="Hand">
                                            <Button.Content>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <fa:IconImage Icon="Clock" Width="13" Height="13" Foreground="#0E7074" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Salida" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button.Content>
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#EDF2F7" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource TealLightBrush}" />
                                                            <Setter Property="Foreground" Value="{StaticResource TealBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Píldora Mejor Precio -->
                                        <Button Command="{Binding OrdenarPorPrecioCommand}"
                                                FontFamily="Segoe UI" FontSize="11.5" FontWeight="SemiBold"
                                                Padding="10,4" Margin="2,0" Cursor="Hand">
                                            <Button.Content>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <fa:IconImage Icon="Coins" Width="13" Height="13" Foreground="#333333" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Mejor Precio" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button.Content>
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#EDF2F7" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource TealLightBrush}" />
                                                            <Setter Property="Foreground" Value="{StaticResource TealBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Lista Vertical de Tarjetas de Pasaje (Cards) -->
                            <ItemsControl ItemsSource="{Binding ViajesDisponibles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                                CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="8" Opacity="0.06" Direction="270" ShadowDepth="2" Color="#000000" />
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Cabecera de la tarjeta: Empresa, Placa y Badges -->
                                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Image Source="pack://application:,,,/SistemaTransportes;component/imagenes/bus.png"
                                                               Width="16" Height="16" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center" />
                                                        <TextBlock Text="TURISMO" FontFamily="Segoe UI" FontWeight="Bold" FontSize="11"
                                                                   Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <Border Background="#FEFCBF" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding BusPlaca, StringFormat='Bus: {0}'}" FontFamily="Segoe UI" FontWeight="SemiBold"
                                                                       FontSize="10.5" Foreground="#744210" />
                                                        </Border>
                                                        <Border Background="#EDF2F7" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TipoServicio}" FontFamily="Segoe UI" FontWeight="SemiBold"
                                                                       FontSize="10.5" Foreground="#4A5568" />
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Categoría badge (Oculto en Solo Encomienda) -->
                                                    <ContentControl Grid.Column="1" Style="{StaticResource CategoriaBadgeControlStyle}"
                                                                    Visibility="{Binding DataContext.EsSoloEncomienda, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisConverter}}" />

                                                    <!-- Insignia Carga en Bodega (Alineada arriba a la derecha en Solo Encomienda) -->
                                                    <Border Grid.Column="1"
                                                            Visibility="{Binding DataContext.EsSoloEncomienda, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}"
                                                            Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <fa:IconImage Icon="BoxOpen" Width="12" Height="12" Foreground="#1E40AF" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="Carga en Bodega" FontFamily="Segoe UI" FontWeight="Bold" FontSize="11" Foreground="#1E40AF" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <!-- Cuerpo principal: Salida | Duración | Llegada | Tarifa + Botón -->
                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <!-- Col 0: Salida -->
                                                        <ColumnDefinition Width="130" />
                                                        <!-- Col 1: Duración -->
                                                        <ColumnDefinition Width="*" />
                                                        <!-- Col 2: Llegada -->
                                                        <ColumnDefinition Width="130" />
                                                        <!-- Col 3: Precio y Botón -->
                                                        <ColumnDefinition Width="160" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Salida -->
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="SALIDA" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="10"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                                        <TextBlock Text="{Binding HoraSalidaTexto}" FontFamily="Segoe UI" FontWeight="Bold" FontSize="16"
                                                                   Foreground="{StaticResource PrimaryBrush}" />
                                                        <TextBlock Text="{Binding FechaHoraSalida, StringFormat='{}{0:ddd, dd/MM}'}" FontFamily="Segoe UI" FontSize="11.5"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </StackPanel>

                                                    <!-- Duración e Indicador -->
                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                                            <TextBlock Text="⏱ " FontSize="11" Foreground="{StaticResource IconGrayBrush}" />
                                                            <TextBlock Text="{Binding Duracion}" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11"
                                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                        <!-- Línea de trayecto -->
                                                        <Grid Width="120" Height="8">
                                                            <Line X1="6" Y1="4" X2="114" Y2="4" Stroke="#CBD5E0" StrokeThickness="1.5" StrokeDashArray="2 2" />
                                                            <Ellipse Width="6" Height="6" Fill="{StaticResource TealBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                            <Polygon Points="114,1 120,4 114,7" Fill="{StaticResource TealBrush}" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding Origen, StringFormat='{}{0} ➔'}" FontFamily="Segoe UI" FontSize="10"
                                                                   Foreground="#A0AEC0" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>

                                                    <!-- Llegada -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="LLEGADA" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="10"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                                        <TextBlock Text="{Binding HoraLlegadaTexto}" FontFamily="Segoe UI" FontWeight="Bold" FontSize="16"
                                                                   Foreground="{StaticResource PrimaryBrush}" />
                                                        <TextBlock Text="{Binding FechaHoraLlegada, StringFormat='{}{0:ddd, dd/MM}'}" FontFamily="Segoe UI" FontSize="11.5"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </StackPanel>

                                                    <!-- Precio y Botón Comprar / Seleccionar -->
                                                    <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <!-- Modo Pasajes: Precio por Pasajero -->
                                                        <StackPanel Visibility="{Binding DataContext.EsModoPasajeConEquipaje, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                                                            <TextBlock Text="{Binding EtiquetaTarifa}" FontFamily="Segoe UI" FontSize="10"
                                                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                                                            <TextBlock Text="{Binding PrecioBase, Converter={StaticResource CurrencyConverter}}"
                                                                       FontFamily="Segoe UI" FontWeight="Bold" FontSize="17"
                                                                       Foreground="{StaticResource TealBrush}" HorizontalAlignment="Right" Margin="0,0,0,6" />
                                                        </StackPanel>

                                                        <!-- Botón Dinámico Comprar / Seleccionar Viaje -->
                                                        <Button Command="{Binding DataContext.SeleccionarViajeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                IsEnabled="{Binding SalidaDisponible}"
                                                                FontFamily="Segoe UI" FontWeight="Bold" FontSize="12.5"
                                                                Padding="18,6" HorizontalAlignment="Right">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Content" Value="Comprar" />
                                                                    <Setter Property="Foreground" Value="White" />
                                                                    <Setter Property="Background" Value="{StaticResource TealBrush}" />
                                                                    <Setter Property="Cursor" Value="Hand" />
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="b" Property="Opacity" Value="0.9" />
                                                                                    </Trigger>
                                                                                    <Trigger Property="IsPressed" Value="True">
                                                                                        <Setter TargetName="b" Property="Opacity" Value="0.8" />
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.EsSoloEncomienda, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                            <Setter Property="Content" Value="Seleccionar Viaje" />
                                                                            <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding SalidaDisponible}" Value="False">
                                                                            <Setter Property="Background" Value="#E2E8F0" />
                                                                            <Setter Property="Foreground" Value="#A0AEC0" />
                                                                            <Setter Property="Content" Value="Horario no disponible" />
                                                                            <Setter Property="Cursor" Value="No" />
                                                                            <Setter Property="ForceCursor" Value="True" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Banner Informativo del Viaje Seleccionado (Visible cuando MostrarMapaAsientos es True) -->
                        <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                                Visibility="{Binding MostrarMapaAsientos, Converter={StaticResource BoolToVisConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="✔ Salida seleccionada:" FontFamily="Segoe UI" FontWeight="Bold" FontSize="12" Foreground="#15803D" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding ViajeSeleccionado.SalidaCompletaTexto, StringFormat='{}{0} • '}" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12" Foreground="#15803D" />
                                    <ContentControl DataContext="{Binding ViajeSeleccionado}" Style="{StaticResource CategoriaBadgeControlStyle}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding ViajeSeleccionado.PrecioBase, Converter={StaticResource CurrencyConverter}}" FontFamily="Segoe UI" FontWeight="Bold" FontSize="12.5" Foreground="#15803D" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#DCFCE7" CornerRadius="4" Padding="8,2">
                                    <TextBlock Text="Paso 1: Elija hasta 5 asientos en el bus ➔" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11" Foreground="#166534" />
                                </Border>
                            </Grid>
                        </Border>
                        </StackPanel>

                        <!-- ================================================================= -->
                        <!-- PASO 2: FORMULARIO DINÁMICO DE PASAJEROS (MostrarPanelPasajeros)  -->
                        <!-- ================================================================= -->
                        <StackPanel Visibility="{Binding MostrarPanelPasajeros, Converter={StaticResource BoolToVisConverter}}">
                            <!-- Barra Superior de Navegación y Resumen del Viaje -->
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Botón Volver al Paso 1 -->
                                    <Button Grid.Column="0"
                                            Command="{Binding VolverAViajesCommand}"
                                            Cursor="Hand" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#EDF2F7" />
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="FontFamily" Value="Segoe UI" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="FontSize" Value="12" />
                                                <Setter Property="Padding" Value="12,6" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="b" Property="Background" Value="#E2E8F0" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding TextoBotonVolverDePaso2}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Resumen del Viaje en Píldoras -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border Background="{StaticResource TealLightBrush}" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding ViajeSeleccionado.SalidaCompletaTexto}"
                                                       FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TealBrush}" />
                                        </Border>
                                        <ContentControl DataContext="{Binding ViajeSeleccionado}" Style="{StaticResource CategoriaBadgeControlStyle}"
                                                        Visibility="{Binding DataContext.EsModoPasajeConEquipaje, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}" />
                                        <Border Visibility="{Binding DataContext.EsSoloEncomienda, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}"
                                                Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <fa:IconImage Icon="BoxOpen" Width="12" Height="12" Foreground="#1E40AF" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Carga en Bodega" FontFamily="Segoe UI" FontWeight="Bold" FontSize="11" Foreground="#1E40AF" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ========================================================================= -->
                            <!-- MODO A: REGISTRO DE PASAJEROS (Modo Pasaje con Equipaje Opcional)         -->
                            <!-- ========================================================================= -->
                            <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="18,16" Margin="0,0,0,14"
                                    Visibility="{Binding EsModoPasajeConEquipaje, Converter={StaticResource BoolToVisConverter}}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" Opacity="0.06" Direction="270" ShadowDepth="2" Color="#000000" />
                                </Border.Effect>
                                <StackPanel>
                                    <!-- Encabezado de la Sección -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="👥 Registro de Pasajeros"
                                                           FontFamily="Segoe UI" FontWeight="Bold" FontSize="16"
                                                           Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Border Background="#DCFCE7" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                    <TextBlock Text="Paso 2 de 3" FontFamily="Segoe UI" FontWeight="Bold" FontSize="10.5" Foreground="#166534" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Ingrese el DNI (8 dígitos) y nombres completos de los pasajeros asignados a cada butaca."
                                                       FontFamily="Segoe UI" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <!-- Badge Total Asientos -->
                                        <Border Grid.Column="1" Background="{StaticResource PrimaryAccentBrush}" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AsientosSeleccionados.Count, StringFormat='{}{0} Asiento(s)'}"
                                                       FontFamily="Segoe UI" FontWeight="Bold" FontSize="12.5" Foreground="White" />
                                        </Border>
                                    </Grid>

                                    <!-- Lista Dinámica de Tarjetas de Pasajeros -->
                                    <ItemsControl ItemsSource="{Binding Pasajeros}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                                        CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                                                    <StackPanel>
                                                        <!-- Cabecera de la Tarjeta del Pasajero -->
                                                        <Grid Margin="0,0,0,10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Badges de Asiento y Piso -->
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Border Background="{StaticResource PrimaryBrush}" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                                                                    <TextBlock Text="{Binding NroAsiento, StringFormat='Asiento N° {0}'}"
                                                                               FontFamily="Segoe UI" FontWeight="Bold" FontSize="11.5" Foreground="White" />
                                                                </Border>
                                                                <Border Background="#E2E8F0" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                                    <TextBlock Text="{Binding Piso, StringFormat='Piso {0}'}"
                                                                               FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11" Foreground="#4A5568" />
                                                                </Border>
                                                            </StackPanel>

                                                            <!-- Tarifa Individual -->
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="Tarifa: " FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Precio, Converter={StaticResource CurrencyConverter}}"
                                                                           FontFamily="Segoe UI" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TealBrush}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Inputs DNI y Nombres en 2 columnas -->
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="160" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- DNI del Pasajero -->
                                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                                <TextBlock Text="DNI (8 dígitos):" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11.5"
                                                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3" />
                                                                <TextBox Text="{Binding Dni, UpdateSourceTrigger=PropertyChanged}"
                                                                         MaxLength="8"
                                                                         Style="{StaticResource ModernTextBoxStyle}" />
                                                            </StackPanel>

                                                            <!-- Nombres Completos -->
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="Nombres y Apellidos Completos:" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11.5"
                                                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3" />
                                                                <TextBox Text="{Binding Nombres, UpdateSourceTrigger=PropertyChanged}"
                                                                         Style="{StaticResource ModernTextBoxStyle}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Botón Inferior para Continuar al Paso 3 -->
                                    <Button Command="{Binding IrAPagoCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Height="46" Margin="0,4,0,0" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding TextoBotonContinuarAPago}" FontFamily="Segoe UI" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- ========================================================================= -->
                            <!-- MODO B: GUÍA DE DESPACHO ESPECIALIZADA DE ENCOMIENDA (EsSoloEncomienda)   -->
                            <!-- ========================================================================= -->
                            <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="18,16" Margin="0,0,0,14"
                                    Visibility="{Binding EsSoloEncomienda, Converter={StaticResource BoolToVisConverter}}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" Opacity="0.06" Direction="270" ShadowDepth="2" Color="#000000" />
                                </Border.Effect>
                                <StackPanel>
                                    <!-- Encabezado de la Guía de Despacho -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📦 Guía de Despacho y Registro de Encomienda"
                                                           FontFamily="Segoe UI" FontWeight="Bold" FontSize="16"
                                                           Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Border Background="#DBEAFE" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                    <TextBlock Text="Paso 2 de 3" FontFamily="Segoe UI" FontWeight="Bold" FontSize="10.5" Foreground="#1E40AF" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Registre los datos del remitente, destinatario y modalidad de entrega para la carga en bodega."
                                                       FontFamily="Segoe UI" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <!-- Badge Bulto y Tarifa -->
                                        <Border Grid.Column="1" Background="{StaticResource PrimaryAccentBrush}" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PresetSeleccionado.TarifaDisplay, StringFormat='Tarifa: {0}'}"
                                                       FontFamily="Segoe UI" FontWeight="Bold" FontSize="12.5" Foreground="White" />
                                        </Border>
                                    </Grid>

                                    <!-- SECCIÓN 1: REMITENTE -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="👤 1. Datos del Remitente (Quien envía)" FontFamily="Segoe UI" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="140" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Tipo Doc -->
                                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                    <TextBlock Text="Tipo Doc:" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3" />
                                                    <ComboBox ItemsSource="{Binding TiposDocumentoDisponibles}"
                                                              SelectedItem="{Binding RemitenteTipoDoc, Mode=TwoWay}"
                                                              Style="{StaticResource {x:Type ComboBox}}"
                                                              Height="34" />
                                                </StackPanel>

                                                <!-- Nro Doc -->
                                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                    <TextBlock Text="N° Documento:" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3" />
                                                    <TextBox Text="{Binding RemitenteDoc, UpdateSourceTrigger=PropertyChanged}"
                                                             MaxLength="{Binding RemitenteDocMaxLength}"
                                                             Style="{StaticResource ModernTextBoxStyle}" />
                                                </StackPanel>

                                                <!-- Nombres / Razon Social -->
                                                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                                    <TextBlock Text="Nombres / Razón Social:" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3" />
                                                    <TextBox Text="{Binding RemitenteNombre, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource ModernTextBoxStyle}" />
                                                </StackPanel>

                                                <!-- Celular -->
                                                <StackPanel Grid.Column="3">
                                                    <TextBlock Text="Teléfono Celular (9 dígitos):" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3" />
                                                    <TextBox Text="{Binding RemitenteTelefono, UpdateSourceTrigger=PropertyChanged}"
                                                             MaxLength="9"
                                                             Style="{StaticResource ModernTextBoxStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- SECCIÓN 2: DESTINATARIO -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="📍 2. Datos del Destinatario (Quien recoge/recibe)" FontFamily="Segoe UI" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="140" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Tipo Doc -->
                                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                    <TextBlock Text="Tipo Doc:" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3" />
                                                    <ComboBox ItemsSource="{Binding TiposDocumentoDisponibles}"
                                                              SelectedItem="{Binding DestinatarioTipoDoc, Mode=TwoWay}"
                                                              Style="{StaticResource {x:Type ComboBox}}"
                                                              Height="34" />
                                                </StackPanel>

                                                <!-- Nro Doc -->
                                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                    <TextBlock Text="N° Documento:" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3" />
                                                    <TextBox Text="{Binding DestinatarioDoc, UpdateSourceTrigger=PropertyChanged}"
                                                             MaxLength="{Binding DestinatarioDocMaxLength}"
                                                             Style="{StaticResource ModernTextBoxStyle}" />
                                                </StackPanel>

                                                <!-- Nombres / Razon Social -->
                                                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                                    <TextBlock Text="Nombres / Razón Social:" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3" />
                                                    <TextBox Text="{Binding DestinatarioNombre, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource ModernTextBoxStyle}" />
                                                </StackPanel>

                                                <!-- Celular -->
                                                <StackPanel Grid.Column="3">
                                                    <TextBlock Text="Teléfono Celular (9 dígitos):" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3" />
                                                    <TextBox Text="{Binding DestinatarioTelefono, UpdateSourceTrigger=PropertyChanged}"
                                                             MaxLength="9"
                                                             Style="{StaticResource ModernTextBoxStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- SECCIÓN 3: MODALIDAD Y DESTINO DE ENTREGA -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="🚚 3. Modalidad y Destino de Entrega" FontFamily="Segoe UI" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10" />

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <RadioButton IsChecked="{Binding EsEntregaAgencia, Mode=TwoWay}"
                                                             FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12.5"
                                                             Foreground="{StaticResource PrimaryBrush}" Cursor="Hand" Margin="0,0,24,0">
                                                    <RadioButton.Content>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <fa:IconImage Icon="Building" Width="14" Height="14" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="Recojo en Agencia / Almacén (S/. 0.00)" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </RadioButton.Content>
                                                </RadioButton>
                                                <RadioButton IsChecked="{Binding EsEntregaDomicilio, Mode=TwoWay}"
                                                             FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12.5"
                                                             Foreground="{StaticResource ContrastOrangeBrush}" Cursor="Hand">
                                                    <RadioButton.Content>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <fa:IconImage Icon="House" Width="14" Height="14" Foreground="{StaticResource ContrastOrangeBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="Entrega a Domicilio (+S/. 10.00 recargo)" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </RadioButton.Content>
                                                </RadioButton>
                                            </StackPanel>

                                            <!-- Opcion A: Agencia -->
                                            <Border Background="#E6FFFA" BorderBrush="#81E6D9" BorderThickness="1" CornerRadius="6" Padding="12,10"
                                                    Visibility="{Binding EsEntregaAgencia, Converter={StaticResource BoolToVisConverter}}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <fa:IconImage Icon="Building" Width="16" Height="16" Foreground="#234E52" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TerminalLlegadaDisplay}" FontFamily="Segoe UI" FontWeight="Bold" FontSize="12" Foreground="#234E52" />
                                                        <TextBlock Text="El destinatario deberá acercarse con su documento de identidad original para retirar el bulto." FontFamily="Segoe UI" FontSize="11" Foreground="#285E61" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- Opcion B: Domicilio -->
                                            <StackPanel Visibility="{Binding EsEntregaDomicilio, Converter={StaticResource BoolToVisConverter}}">
                                                <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                                    <TextBlock Text="ℹ Servicio de entrega urbana en ciudad destino. Se adiciona S/. 10.00 a la liquidación final." FontFamily="Segoe UI" FontSize="11" Foreground="#92400E" />
                                                </Border>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.4*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Direccion Exacta -->
                                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                        <TextBlock Text="Dirección Exacta de Entrega (Obligatorio, mín. 5 caracteres):" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3" />
                                                        <TextBox Text="{Binding DireccionEntrega, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource ModernTextBoxStyle}" />
                                                    </StackPanel>

                                                    <!-- Referencia -->
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Referencia / Indicaciones de Entrega (Opcional):" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3" />
                                                        <TextBox Text="{Binding ReferenciaEntrega, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource ModernTextBoxStyle}" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Botón Inferior para Continuar al Paso 3 -->
                                    <Button Command="{Binding IrAPagoCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Height="46" Margin="0,4,0,0" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding TextoBotonContinuarAPago}" FontFamily="Segoe UI" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ================================================================= -->
                        <!-- PASO 3: CONFIRMACIÓN DE COMPRA Y MÉTODO DE PAGO (MostrarPanelPago) -->
                        <!-- ================================================================= -->
                        <StackPanel Visibility="{Binding MostrarPanelPago, Converter={StaticResource BoolToVisConverter}}">
                            <!-- Barra Superior de Navegación y Resumen del Viaje -->
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Botón Volver al Paso 2 -->
                                    <Button Grid.Column="0"
                                            Command="{Binding VolverAPasajerosCommand}"
                                            Cursor="Hand" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#EDF2F7" />
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="FontFamily" Value="Segoe UI" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="FontSize" Value="12" />
                                                <Setter Property="Padding" Value="12,6" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="b" Property="Background" Value="#E2E8F0" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="← " FontWeight="Bold" />
                                            <TextBlock Text="{Binding TextoBotonVolverDePago}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Resumen del Viaje en Píldoras -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border Background="{StaticResource TealLightBrush}" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding ViajeSeleccionado.SalidaCompletaTexto}"
                                                       FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TealBrush}" />
                                        </Border>
                                        <ContentControl DataContext="{Binding ViajeSeleccionado}" Style="{StaticResource CategoriaBadgeControlStyle}"
                                                        Visibility="{Binding DataContext.EsModoPasajeConEquipaje, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}" />
                                        <Border Visibility="{Binding DataContext.EsSoloEncomienda, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}"
                                                Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <fa:IconImage Icon="BoxOpen" Width="12" Height="12" Foreground="#1E40AF" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Carga en Bodega" FontFamily="Segoe UI" FontWeight="Bold" FontSize="11" Foreground="#1E40AF" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Tarjeta Contenedora de Pago y Confirmación -->
                            <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="18,16" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" Opacity="0.06" Direction="270" ShadowDepth="2" Color="#000000" />
                                </Border.Effect>
                                <StackPanel>
                                    <!-- Encabezado de la Sección -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="💳 Confirmación de Compra y Método de Pago"
                                                           FontFamily="Segoe UI" FontWeight="Bold" FontSize="16"
                                                           Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Border Background="#DBEAFE" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                    <TextBlock Text="Paso 3 de 3" FontFamily="Segoe UI" FontWeight="Bold" FontSize="10.5" Foreground="#1E40AF" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Seleccione el método de pago, registre el importe recibido y confirme la emisión de los boletos."
                                                       FontFamily="Segoe UI" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <!-- Badge Total a Pagar -->
                                        <Border Grid.Column="1" Background="{StaticResource ContrastOrangeBrush}" CornerRadius="6" Padding="12,5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TotalVenta, Converter={StaticResource CurrencyConverter}, StringFormat='Total: {0}'}"
                                                       FontFamily="Segoe UI" FontWeight="Bold" FontSize="13.5" Foreground="White" />
                                        </Border>
                                    </Grid>

                                    <!-- Grid de 2 Columnas: Panel de Pago (Izq) y Resumen del Viaje (Der) -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="0.9*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- COLUMNA IZQUIERDA: Selector de Método de Pago y Liquidación -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Seleccione el Método de Pago:"
                                                       FontFamily="Segoe UI" FontWeight="Bold" FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />

                                            <!-- RadioButtons estilizados como Tarjetas -->
                                            <UniformGrid Columns="3" Margin="0,0,0,16">
                                                <!-- Efectivo -->
                                                <RadioButton GroupName="MetodoPago"
                                                             IsChecked="{Binding MetodoPagoSeleccionado, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Efectivo, Mode=TwoWay}"
                                                             Cursor="Hand" Margin="0,0,4,0">
                                                    <RadioButton.Template>
                                                        <ControlTemplate TargetType="RadioButton">
                                                            <Border x:Name="bd" Background="#F8FAFC" BorderBrush="#CBD5E0" BorderThickness="1.5"
                                                                    CornerRadius="8" Padding="8,10">
                                                                <StackPanel HorizontalAlignment="Center">
                                                                    <fa:IconImage Icon="MoneyBill1" Width="22" Height="22" Foreground="#0E7074" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                                    <TextBlock Text="Efectivo" FontFamily="Segoe UI" FontWeight="Bold" FontSize="12"
                                                                               Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" />
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#E0F2F1" />
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource TealBrush}" />
                                                                    <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#F1F5F9" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </RadioButton.Template>
                                                </RadioButton>

                                                <!-- Yape / Plin -->
                                                <RadioButton GroupName="MetodoPago"
                                                             IsChecked="{Binding MetodoPagoSeleccionado, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Yape / Plin', Mode=TwoWay}"
                                                             Cursor="Hand" Margin="2,0,2,0">
                                                    <RadioButton.Template>
                                                        <ControlTemplate TargetType="RadioButton">
                                                            <Border x:Name="bd" Background="#F8FAFC" BorderBrush="#CBD5E0" BorderThickness="1.5"
                                                                    CornerRadius="8" Padding="8,10">
                                                                <StackPanel HorizontalAlignment="Center">
                                                                    <fa:IconImage Icon="MobileScreen" Width="22" Height="22" Foreground="#7C3AED" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                                    <TextBlock Text="Yape / Plin" FontFamily="Segoe UI" FontWeight="Bold" FontSize="12"
                                                                               Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" />
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#EDE9FE" />
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#7C3AED" />
                                                                    <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#F1F5F9" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </RadioButton.Template>
                                                </RadioButton>

                                                <!-- Tarjeta -->
                                                <RadioButton GroupName="MetodoPago"
                                                             IsChecked="{Binding MetodoPagoSeleccionado, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Tarjeta, Mode=TwoWay}"
                                                             Cursor="Hand" Margin="4,0,0,0">
                                                    <RadioButton.Template>
                                                        <ControlTemplate TargetType="RadioButton">
                                                            <Border x:Name="bd" Background="#F8FAFC" BorderBrush="#CBD5E0" BorderThickness="1.5"
                                                                    CornerRadius="8" Padding="8,10">
                                                                <StackPanel HorizontalAlignment="Center">
                                                                    <fa:IconImage Icon="CreditCard" Width="22" Height="22" Foreground="#0284C7" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                                    <TextBlock Text="Tarjeta" FontFamily="Segoe UI" FontWeight="Bold" FontSize="12"
                                                                               Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" />
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#E0F2FE" />
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}" />
                                                                    <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#F1F5F9" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </RadioButton.Template>
                                                </RadioButton>
                                            </UniformGrid>

                                            <!-- Opciones específicas de Efectivo -->
                                            <StackPanel Visibility="{Binding EsPagoEfectivo, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="Monto Recibido en Efectivo (S/.):"
                                                           FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12"
                                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding MontoRecibido, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalConverter}, TargetNullValue=''}"
                                                         GotFocus="TxtMontoRecibido_GotFocus"
                                                         PreviewMouseLeftButtonDown="TxtMontoRecibido_PreviewMouseLeftButtonDown"
                                                         Style="{StaticResource ModernTextBoxStyle}"
                                                         FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                                                         Margin="0,0,0,8" />

                                                <!-- Botones de Monto Rápido -->
                                                <WrapPanel Margin="0,0,0,14">
                                                    <Button Content="[Exacto]" Command="{Binding MontoRapidoCommand}" CommandParameter="Exacto"
                                                            Background="#EDF2F7" Foreground="{StaticResource PrimaryBrush}"
                                                            FontFamily="Segoe UI" FontWeight="Bold" FontSize="11.5"
                                                            Padding="8,5" Margin="0,0,6,6" Cursor="Hand" BorderThickness="0" />
                                                    <Button Content="+S/. 10" Command="{Binding MontoRapidoCommand}" CommandParameter="+10"
                                                            Background="#EDF2F7" Foreground="{StaticResource PrimaryBrush}"
                                                            FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11.5"
                                                            Padding="8,5" Margin="0,0,6,6" Cursor="Hand" BorderThickness="0" />
                                                    <Button Content="+S/. 20" Command="{Binding MontoRapidoCommand}" CommandParameter="+20"
                                                            Background="#EDF2F7" Foreground="{StaticResource PrimaryBrush}"
                                                            FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11.5"
                                                            Padding="8,5" Margin="0,0,6,6" Cursor="Hand" BorderThickness="0" />
                                                    <Button Content="+S/. 50" Command="{Binding MontoRapidoCommand}" CommandParameter="+50"
                                                            Background="#EDF2F7" Foreground="{StaticResource PrimaryBrush}"
                                                            FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11.5"
                                                            Padding="8,5" Margin="0,0,6,6" Cursor="Hand" BorderThickness="0" />
                                                    <Button Content="S/. 100" Command="{Binding MontoRapidoCommand}" CommandParameter="100"
                                                            Background="#EDF2F7" Foreground="{StaticResource PrimaryBrush}"
                                                            FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11.5"
                                                            Padding="8,5" Margin="0,0,6,6" Cursor="Hand" BorderThickness="0" />
                                                </WrapPanel>

                                                <!-- Indicador Destacado de Vuelto o Advertencia de Falta Dinero -->
                                                <Border Background="#FDF2F2" BorderBrush="#F87171" BorderThickness="1.5" CornerRadius="8" Padding="12,10"
                                                        Margin="0,0,0,10"
                                                        Visibility="{Binding FaltaDinero, Converter={StaticResource BoolToVisConverter}}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="⚠️ " FontSize="16" Foreground="#DC2626" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding DiferenciaFaltante, StringFormat='Monto insuficiente: Faltan S/. {0:N2}'}"
                                                                   FontFamily="Segoe UI" FontWeight="Bold" FontSize="12.5" Foreground="#B91C1C" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>

                                                <Border Background="#DEF7EC" BorderBrush="#31C48D" BorderThickness="1.5" CornerRadius="8" Padding="12,10"
                                                        Margin="0,0,0,10"
                                                        Visibility="{Binding FaltaDinero, Converter={StaticResource InverseBoolToVisConverter}}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="✓ " FontSize="16" FontWeight="Bold" Foreground="#03543F" VerticalAlignment="Center" />
                                                        <TextBlock Text="Vuelto a entregar: " FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12.5" Foreground="#03543F" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Vuelto, Converter={StaticResource CurrencyConverter}}"
                                                                   FontFamily="Segoe UI" FontWeight="Bold" FontSize="15" Foreground="#03543F" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- Opciones específicas de Pago Digital (Yape / Plin o Tarjeta) -->
                                            <StackPanel Visibility="{Binding EsPagoDigital, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="N° de Operación / Referencia (Opcional):"
                                                           FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12"
                                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding NroOperacion, UpdateSourceTrigger=PropertyChanged}"
                                                         MaxLength="{Binding MaxLongitudOperacion}"
                                                         PreviewTextInput="NumeroOperacion_PreviewTextInput"
                                                         DataObject.Pasting="NumeroOperacion_Pasting"
                                                         Style="{StaticResource ModernTextBoxStyle}"
                                                         FontSize="13.5" Margin="0,0,0,10" />
                                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="ℹ️ " FontSize="13" Foreground="#2563EB" VerticalAlignment="Center" />
                                                        <TextBlock Text="Confirmación digital inmediata. Verifique la acreditación en la cuenta bancaria antes de confirmar."
                                                                   FontFamily="Segoe UI" FontSize="11" Foreground="#1E40AF" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- COLUMNA DERECHA: Resumen Consolidado del Viaje y Pasajeros -->
                                        <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                                CornerRadius="8" Padding="14,12">
                                            <StackPanel>
                                                <TextBlock Text="📋 Resumen de la Venta"
                                                           FontFamily="Segoe UI" FontWeight="Bold" FontSize="13"
                                                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10" />

                                                <!-- Detalle del Viaje -->
                                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding ViajeSeleccionado.RutaTexto}"
                                                                   FontFamily="Segoe UI" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource PrimaryBrush}" />
                                                        <TextBlock Text="{Binding ViajeSeleccionado.SalidaCompletaTexto}"
                                                                   FontFamily="Segoe UI" FontSize="11.5" Foreground="{StaticResource TealBrush}" FontWeight="SemiBold" Margin="0,2,0,0" />
                                                        <TextBlock Text="{Binding ViajeSeleccionado.Categoria, StringFormat='Servicio: {0}'}"
                                                                   Visibility="{Binding EsModoPasajeConEquipaje, Converter={StaticResource BoolToVisConverter}}"
                                                                   FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                        <TextBlock Text="Servicio: 📦 Carga en Bodega"
                                                                   Visibility="{Binding EsSoloEncomienda, Converter={StaticResource BoolToVisConverter}}"
                                                                   FontFamily="Segoe UI" FontSize="11" Foreground="#1E40AF" FontWeight="SemiBold" Margin="0,2,0,0" />
                                                        <TextBlock Text="{Binding ViajeSeleccionado.PlacaBus, StringFormat='Bus Placa: {0}'}"
                                                                   FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Lista Compacta de Pasajeros y Asientos (Modo Pasaje con Equipaje) -->
                                                <StackPanel Visibility="{Binding EsModoPasajeConEquipaje, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="Pasajeros y Asientos Asignados:"
                                                               FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11.5"
                                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                                    <ItemsControl ItemsSource="{Binding Pasajeros}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding NroAsiento, StringFormat='Asiento #{0}'}"
                                                                                       FontFamily="Segoe UI" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource PrimaryBrush}" />
                                                                            <TextBlock Text="{Binding Piso, StringFormat=' (Piso {0})'}"
                                                                                       FontFamily="Segoe UI" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding Nombres}"
                                                                                   FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11" Foreground="#334155" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding Dni, StringFormat='DNI: {0}'}"
                                                                                   FontFamily="Segoe UI" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Precio, Converter={StaticResource CurrencyConverter}}"
                                                                               FontFamily="Segoe UI" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource TealBrush}"
                                                                               VerticalAlignment="Center" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <!-- Detalle de Carga / Encomienda Directa (Modo Solo Encomienda) -->
                                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10"
                                                        Visibility="{Binding EsSoloEncomienda, Converter={StaticResource BoolToVisConverter}}">
                                                    <StackPanel>
                                                        <TextBlock Text="📦 Despacho de Encomienda en Bodega" FontFamily="Segoe UI" FontWeight="Bold" FontSize="11.5" Foreground="#1E40AF" />
                                                        <TextBlock Text="Carga directa en bodega del bus." FontFamily="Segoe UI" FontSize="10.5" Foreground="#3B82F6" Margin="0,2,0,6" />

                                                        <TextBlock Text="Remitente:" FontFamily="Segoe UI" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource PrimaryBrush}" />
                                                        <TextBlock Text="{Binding RemitenteNombre}" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11" Foreground="#334155" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock FontFamily="Segoe UI" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4">
                                                            <Run Text="{Binding RemitenteTipoDoc}" />: <Run Text="{Binding RemitenteDoc}" /> • Cel: <Run Text="{Binding RemitenteTelefono}" />
                                                        </TextBlock>

                                                        <TextBlock Text="Destinatario:" FontFamily="Segoe UI" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource PrimaryBrush}" />
                                                        <TextBlock Text="{Binding DestinatarioNombre}" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11" Foreground="#334155" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock FontFamily="Segoe UI" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4">
                                                            <Run Text="{Binding DestinatarioTipoDoc}" />: <Run Text="{Binding DestinatarioDoc}" /> • Cel: <Run Text="{Binding DestinatarioTelefono}" />
                                                        </TextBlock>

                                                        <TextBlock Text="Entrega:" FontFamily="Segoe UI" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource PrimaryBrush}" />
                                                        <TextBlock Text="{Binding ModalidadEntrega, StringFormat='Modalidad: {0}'}" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="10.5" Foreground="{StaticResource TealBrush}" />
                                                        <TextBlock Text="{Binding DireccionEntrega, StringFormat='Dirección: {0}'}" FontFamily="Segoe UI" FontSize="10" Foreground="#334155" TextWrapping="Wrap"
                                                                   Visibility="{Binding EsEntregaDomicilio, Converter={StaticResource BoolToVisConverter}}" />

                                                        <Separator Background="#CBD5E0" Margin="0,4,0,4" />
                                                        <TextBlock Text="{Binding PresetSeleccionado.Nombre, StringFormat='Bulto: {0}'}" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding EncomiendaDescripcion, StringFormat='Contenido: {0}'}" FontFamily="Segoe UI" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0" />
                                                        <TextBlock Text="{Binding EncomiendaPesoKg, StringFormat='Peso: {0:N1} kg'}" FontFamily="Segoe UI" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Desglose de Liquidación -->
                                                <Separator Background="#CBD5E0" Margin="0,8,0,8" />
                                                <Grid Margin="0,0,0,4" Visibility="{Binding EsModoPasajeConEquipaje, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="Total Boletos:" FontFamily="Segoe UI" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding TotalBoletos, Converter={StaticResource CurrencyConverter}}"
                                                               FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                                </Grid>
                                                <Grid Margin="0,0,0,4" Visibility="{Binding IncluyeEncomienda, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="Carga / Encomienda:" FontFamily="Segoe UI" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding EncomiendaCosto, Converter={StaticResource CurrencyConverter}}"
                                                               FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                                </Grid>
                                                <Grid Margin="0,0,0,6" Visibility="{Binding EsEntregaDomicilio, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="Recargo Delivery:" FontFamily="Segoe UI" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding RecargoDelivery, Converter={StaticResource CurrencyConverter}}"
                                                               FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                                </Grid>
                                                <Separator Background="#CBD5E0" Margin="0,4,0,6" />
                                                <Grid>
                                                    <TextBlock Text="Total Final a Pagar:" FontFamily="Segoe UI" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource PrimaryBrush}" />
                                                    <TextBlock Text="{Binding TotalVenta, Converter={StaticResource CurrencyConverter}}"
                                                               FontFamily="Segoe UI" FontWeight="Bold" FontSize="14" Foreground="{StaticResource ContrastOrangeBrush}" HorizontalAlignment="Right" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Botón de Acción Final: Confirmar Pago y Emitir Boletos / Despachar Encomienda -->
                                    <Button Command="{Binding ConfirmarVentaFinalCommand}"
                                            Background="#16A34A" Foreground="White"
                                            FontFamily="Segoe UI" FontWeight="Bold" FontSize="14"
                                            Height="48" Margin="0,18,0,0" Cursor="Hand" BorderThickness="0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8" />
                                            </Style>
                                        </Button.Resources>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="✓ " FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding TextoBotonConfirmarPago}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- PANEL DERECHO: Carga Adjunta y Liquidacion -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Titulo de Seccion -->
                        <TextBlock Text="📦 Carga Adjunta y Liquidación"
                                   FontFamily="Segoe UI" FontWeight="Bold" FontSize="16"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16" />

                        <!-- Selector de Modalidad: Pasaje con Equipaje vs Solo Encomienda -->
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Modalidad de Atención:" FontFamily="Segoe UI" FontWeight="Bold" FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                <RadioButton Content="Pasaje con Equipaje (Opcional)"
                                             IsChecked="{Binding EsModoPasajeConEquipaje, Mode=TwoWay}"
                                             FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12"
                                             Foreground="{StaticResource PrimaryBrush}" Cursor="Hand" Margin="0,0,0,6" />
                                <RadioButton Content="Solo Envío de Encomienda (Sin Pasaje)"
                                             IsChecked="{Binding EsSoloEncomienda, Mode=TwoWay}"
                                             FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12"
                                             Foreground="{StaticResource TealBrush}" Cursor="Hand" Checked="RadioButton_Checked" />
                            </StackPanel>
                        </Border>

                        <!-- Banner Informativo para Modo Solo Encomienda -->
                        <Border Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                                Visibility="{Binding EsSoloEncomienda, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦 " FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="Modo Encomienda Directa: Carga en bodega. Seleccione el tipo de bulto y el viaje de destino (no requiere asientos)."
                                           FontFamily="Segoe UI" FontSize="11" Foreground="#1E40AF" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Checkbox Interactivo Encomienda / Carga (Modo Pasajes) -->
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12" Margin="0,0,0,16"
                                Visibility="{Binding EsModoPasajeConEquipaje, Converter={StaticResource BoolToVisConverter}}">
                            <CheckBox IsChecked="{Binding IncluyeEncomienda, Mode=TwoWay}"
                                      VerticalContentAlignment="Center" Cursor="Hand">
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="Incluye Equipaje Adicional / Encomienda"
                                               FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{StaticResource PrimaryBrush}" />
                                    <TextBlock Text="Asocia carga al boleto en la misma transacción"
                                               FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <!-- Campos Desplegables de Carga Adjunta con Presets -->
                        <Border Background="#F1F5F9" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14" Margin="0,0,0,20"
                                Visibility="{Binding IncluyeEncomienda, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel>
                                <TextBlock Text="Tipo de Bulto / Encomienda:"
                                           FontFamily="Segoe UI" FontWeight="Bold" FontSize="13"
                                           Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,0,0,8" />

                                <!-- Selector ComboBox de Presets -->
                                <ComboBox ItemsSource="{Binding PresetsDisponibles}"
                                          SelectedItem="{Binding PresetSeleccionado, Mode=TwoWay}"
                                          FontFamily="Segoe UI" FontSize="12.5"
                                          Padding="8,6" Margin="0,0,0,12"
                                          Background="#FFFFFF"
                                          BorderBrush="{StaticResource BorderLightBrush}"
                                          BorderThickness="1">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Icono}" FontSize="14" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                                    <TextBlock Text="{Binding Nombre}" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Descripcion}" FontFamily="Segoe UI" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Background="{StaticResource TealLightBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TarifaDisplay}" FontFamily="Segoe UI" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TealBrush}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Tarjeta Compacta de Confirmación del Bulto Seleccionado -->
                                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                                        CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Icono -->
                                        <TextBlock Grid.Column="0" Text="{Binding PresetSeleccionado.Icono, FallbackValue='📦'}" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                        <!-- Nombre y Descripción del Preset -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,8,0">
                                            <TextBlock Text="{Binding PresetSeleccionado.Nombre, FallbackValue='Caja Chica'}"
                                                       FontFamily="Segoe UI" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource PrimaryBrush}" />
                                            <TextBlock Text="{Binding PresetSeleccionado.Descripcion, FallbackValue='Paquete estándar en bodega'}"
                                                       FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!-- Tarifa Destacada -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="Tarifa Aplicada" FontFamily="Segoe UI" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding EncomiendaCosto, Converter={StaticResource CurrencyConverter}, StringFormat='{}Tarifa: {0}'}"
                                                       FontFamily="Segoe UI" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource ContrastOrangeBrush}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Contenedor Colapsable para 'Personalizado' -->
                                <StackPanel Visibility="{Binding EsCargaPersonalizada, Converter={StaticResource BoolToVisConverter}}">
                                    <Border Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding TarifaPorKg, StringFormat='{}ℹ Medición manual en balanza: Ingrese el peso exacto (S/. {0:N2} por Kg) y detalle el contenido.'}"
                                                    FontFamily="Segoe UI" FontSize="11" Foreground="#92400E" TextWrapping="Wrap" />
                                    </Border>

                                    <!-- Descripción del Contenido -->
                                    <TextBlock Text="Descripción Específica del Contenido:"
                                               FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding EncomiendaDescripcion, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             Margin="0,0,0,10" />

                                    <!-- Peso Kg Personalizado -->
                                    <TextBlock Text="{Binding TarifaPorKg, StringFormat='{}Peso en Balanza (Kg) - (Tarifa: S/. {0:N2} / Kg - Máx. 50 Kg):'}"
                                               FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding EncomiendaPesoKgTexto, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="5"
                                             ToolTip="El peso máximo permitido por equipaje/encomienda en bodega es de 50 kg"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             Margin="0,0,0,4" />

                                    <!-- Advertencia de Límite Máximo de Peso -->
                                    <TextBlock Text="⚠ El peso máximo permitido por equipaje/encomienda en bodega es de 50 kg"
                                               FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#D97706" Margin="0,0,0,8"
                                               Visibility="{Binding EsPesoMaximoEncomienda, Converter={StaticResource BoolToVisConverter}}" />

                                    <!-- Costo Carga Calculado -->
                                    <TextBlock Text="Costo Calculado de Carga (S/.):"
                                               FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                    <TextBox Background="#E9ECEF" Focusable="False" IsReadOnly="True" Margin="0,0,0,4" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding EncomiendaCosto, Mode=OneWay, StringFormat='{}{0:N2}'}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Resumen de Liquidacion -->
                        <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Desglose de Liquidación:"
                                           FontFamily="Segoe UI" FontWeight="Bold" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Boletos de Pasaje (" FontFamily="Segoe UI" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding AsientosSeleccionados.Count}" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="):" FontFamily="Segoe UI" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding TotalBoletos, Converter={StaticResource CurrencyConverter}}"
                                               FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Carga / Encomienda:" FontFamily="Segoe UI" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding EncomiendaCosto, Converter={StaticResource CurrencyConverter}}"
                                               FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                </Grid>

                                <Grid Margin="0,0,0,6" Visibility="{Binding EsEntregaDomicilio, Converter={StaticResource BoolToVisConverter}}">
                                    <TextBlock Text="Recargo Delivery:" FontFamily="Segoe UI" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding RecargoDelivery, Converter={StaticResource CurrencyConverter}}"
                                               FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                </Grid>

                                <Separator Background="{StaticResource BorderLightBrush}" Margin="0,6,0,8" />

                                <Grid>
                                    <TextBlock Text="Total Liquidado:" FontFamily="Segoe UI" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PrimaryBrush}" />
                                    <TextBlock Text="{Binding TotalVenta, Converter={StaticResource CurrencyConverter}}"
                                               FontFamily="Segoe UI" FontWeight="Bold" FontSize="16"
                                               Foreground="{StaticResource ContrastOrangeBrush}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 2. FOOTER: Resumen Total a Pagar y Boton 'Emitir Venta Integrada' -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Alertas / Feedback Concurrencia y Estado -->
                    <ColumnDefinition Width="*" />
                    <!-- Resumen de Monto -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Boton Principal -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Feedback / Alerta de Transaccion y Concurrencia -->
                <Border Grid.Column="0" CornerRadius="6" Padding="14,10" Margin="0,0,20,0"
                        Visibility="{Binding MostrarAlerta, Converter={StaticResource BoolToVisConverter}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#EFF6FF" />
                            <Setter Property="BorderBrush" Value="#93C5FD" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TipoAlerta}" Value="Exito">
                                    <Setter Property="Background" Value="#DEF7EC" />
                                    <Setter Property="BorderBrush" Value="#31C48D" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TipoAlerta}" Value="Error">
                                    <Setter Property="Background" Value="#FDF2F2" />
                                    <Setter Property="BorderBrush" Value="#F98080" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding MensajeAlerta}"
                               FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="13"
                               TextWrapping="Wrap" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#1E40AF" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TipoAlerta}" Value="Exito">
                                        <Setter Property="Foreground" Value="#03543F" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TipoAlerta}" Value="Error">
                                        <Setter Property="Foreground" Value="#9B1C1C" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- Resumen Total a Pagar -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0" HorizontalAlignment="Right">
                    <TextBlock Text="TOTAL A PAGAR:"
                               FontFamily="Segoe UI" FontWeight="Bold" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding TotalVenta, Converter={StaticResource CurrencyConverter}}"
                               FontFamily="Segoe UI" FontWeight="Bold" FontSize="26"
                               Foreground="{StaticResource ContrastOrangeBrush}" HorizontalAlignment="Right" />
                </StackPanel>

                <!-- Botón Principal de Acción (Paso 1, Paso 2 y Paso 3) -->
                <Grid Grid.Column="2">
                    <Button Command="{Binding IrAPasajerosCommand}"
                            Visibility="{Binding MostrarPanelViajes, Converter={StaticResource BoolToVisConverter}}"
                            Height="52" MinWidth="260" Style="{StaticResource ContrastButtonStyle}">
                        <TextBlock FontSize="13.5" FontWeight="Bold" Text="{Binding TextoBotonContinuar}" VerticalAlignment="Center"/>
                    </Button>
                    <Button Command="{Binding IrAPagoCommand}"
                            Visibility="{Binding MostrarPanelPasajeros, Converter={StaticResource BoolToVisConverter}}"
                            Height="52" MinWidth="260" Style="{StaticResource ContrastButtonStyle}">
                        <TextBlock FontSize="13.5" FontWeight="Bold" Text="{Binding TextoBotonContinuarAPago}" VerticalAlignment="Center"/>
                    </Button>
                    <Button Command="{Binding ConfirmarVentaFinalCommand}"
                            Visibility="{Binding MostrarPanelPago, Converter={StaticResource BoolToVisConverter}}"
                            Background="#16A34A" Foreground="White"
                            BorderThickness="0"
                            Height="52" MinWidth="260" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TextoBotonFooterConfirmar}" VerticalAlignment="Center" FontWeight="Bold" FontSize="13" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
