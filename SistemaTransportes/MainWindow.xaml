<Window x:Class="SistemaTransportes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SistemaTransportes"
        mc:Ignorable="d"
        Title="Sistema de Transportes - Acceso al Sistema"
        Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgGeneralBrush}">
    <Grid>
        <!-- Tarjeta Corporativa Centrada -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="460"
                Background="{StaticResource PanelCardBrush}"
                CornerRadius="12"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="1"
                Padding="36,40">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Opacity="0.08" ShadowDepth="4" Direction="270" Color="#000000" />
            </Border.Effect>

            <StackPanel>
                <!-- Encabezado / Logo: Icono de bus circular corporativo -->
                <Border Width="64" Height="64" CornerRadius="32"
                        Background="{StaticResource PrimaryBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Image Source="pack://application:,,,/SistemaTransportes;component/imagenes/bus_white.png"
                           Width="38" Height="38"
                           Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Título y Subtítulo -->
                <TextBlock Text="SISTEMA DE TRANSPORTES"
                           FontFamily="Segoe UI" FontWeight="Bold" FontSize="20"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center" />

                <TextBlock Text="Módulo de Venta Integrada y Operaciones"
                           FontFamily="Segoe UI" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,24" />

                <!-- Campo Usuario -->
                <TextBlock Text="Usuario"
                           FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                <TextBox x:Name="txtUsuario"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Margin="0,0,0,16" />

                <!-- Campo Contraseña -->
                <TextBlock Text="Contraseña"
                           FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                <PasswordBox x:Name="txtPassword"
                             Style="{StaticResource ModernPasswordBoxStyle}"
                             Margin="0,0,0,20" />

                <!-- Botón Principal -->
                <Button x:Name="btnIngresar"
                        Click="BtnIngresar_Click"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="44" Margin="0,0,0,24">
                    <TextBlock Text="Ingresar al Sistema" VerticalAlignment="Center" />
                </Button>

                <!-- Separador -->
                <Separator Background="{StaticResource BorderLightBrush}" Margin="0,0,0,16" />

                <!-- Acceso Rápido Operador Único -->
                <TextBlock Text="Acceso Rápido - Operador Único:"
                           FontFamily="Segoe UI" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />

                <Button x:Name="btnAccesoRapido"
                        Click="BtnAccesoRapido_Click"
                        Background="#EEF2F6" Foreground="{StaticResource PrimaryAccentBrush}"
                        FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12"
                        Padding="12,8" Margin="0,0,0,10" Cursor="Hand" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="👤 OpControl (Operador de Control)" VerticalAlignment="Center" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </Button>

                <!-- Leyenda Inferior en Cursiva -->
                <TextBlock Text="Credenciales de acceso: OpControl / 1598753"
                           FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" FontStyle="Italic" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
