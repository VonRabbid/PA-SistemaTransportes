<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>SistemaTransportes</RootNamespace>
    <AssemblyName>SistemaTransportes</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FontAwesome.Sharp" Version="6.6.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="imagenes\*.png" />
    <None Update="imagenes\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SistemaTransportes.Domain\SistemaTransportes.Domain.csproj" />
    <ProjectReference Include="..\SistemaTransportes.Application\SistemaTransportes.Application.csproj" />
    <ProjectReference Include="..\SistemaTransportes.Infrastructure\SistemaTransportes.Infrastructure.csproj" />
  </ItemGroup>

</Project>
