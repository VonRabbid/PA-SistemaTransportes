<Window x:Class="SistemaTransportes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SistemaTransportes"
        xmlns:mvvm="clr-namespace:SistemaTransportes.UI.MVVM"
        xmlns:vm="clr-namespace:SistemaTransportes.UI.ViewModels"
        mc:Ignorable="d"
        Title="Sistema de Transportes - Acceso al Sistema"
        Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgGeneralBrush}">
    <Grid>
        <!-- Tarjeta Corporativa Centrada -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="460"
                Background="{StaticResource PanelCardBrush}"
                CornerRadius="12"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="1"
                Padding="36,40">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Opacity="0.08" ShadowDepth="4" Direction="270" Color="#000000" />
            </Border.Effect>

            <StackPanel>
                <!-- Encabezado / Logo: Icono de bus circular corporativo -->
                <Border Width="64" Height="64" CornerRadius="32"
                        Background="{StaticResource PrimaryBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Image Source="pack://application:,,,/SistemaTransportes;component/imagenes/bus_white.png"
                           Width="38" Height="38"
                           Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Título y Subtítulo -->
                <TextBlock Text="SISTEMA DE TRANSPORTES"
                           FontFamily="Segoe UI" FontWeight="Bold" FontSize="20"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center" />

                <TextBlock Text="Módulo de Venta Integrada y Operaciones"
                           FontFamily="Segoe UI" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,24" />

                <!-- Campo Usuario -->
                <TextBlock Text="Usuario"
                           FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                <TextBox x:Name="txtUsuario"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Margin="0,0,0,16" />

                <!-- Campo Contraseña -->
                <TextBlock Text="Contraseña"
                           FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                <PasswordBox x:Name="txtPassword"
                             mvvm:PasswordBoxHelper.BindPassword="True"
                             mvvm:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernPasswordBoxStyle}"
                             Margin="0,0,0,20" />

                <!-- Botón Principal -->
                <Button x:Name="btnIngresar"
                        Command="{Binding IngresarCommand}"
                        CommandParameter="{Binding ElementName=txtPassword}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="44" Margin="0,0,0,24">
                    <TextBlock Text="Ingresar al Sistema" VerticalAlignment="Center" />
                </Button>

                <!-- Separador -->
                <Separator Background="{StaticResource BorderLightBrush}" Margin="0,0,0,16" />

                <!-- Acceso Rápido Selección de Operador -->
                <TextBlock Text="Acceso Rápido - Selección de Ventanilla:"
                           FontFamily="Segoe UI" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="btnAccesoRapido"
                            Command="{Binding AccesoRapido1Command}"
                            Background="#EEF2F6" Foreground="{StaticResource PrimaryAccentBrush}"
                            FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11"
                            Padding="6,8" Cursor="Hand" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="👤 OpControl (Ventanilla 1)" VerticalAlignment="Center" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </Button>

                    <Button Grid.Column="2" x:Name="btnAccesoRapido2"
                            Command="{Binding AccesoRapido2Command}"
                            Background="#F0FDF4" Foreground="#15803D"
                            FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11"
                            Padding="6,8" Cursor="Hand" BorderThickness="1" BorderBrush="#BBF7D0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="👤 OpVenta2 (Ventanilla 2)" VerticalAlignment="Center" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </Button>
                </Grid>

                <!-- Leyenda Inferior en Cursiva -->
                <TextBlock Text="Contraseña unificada: 1598753 (Ventanilla 1 y Ventanilla 2)"
                           FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" FontStyle="Italic" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
